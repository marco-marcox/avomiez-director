{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {"source": "/api/reference-builder", "destination": "/api/develop-idea"},
    {"source": "/api/micro-drama", "destination": "/api/develop-idea"}
  ],
  "redirects": [
    {"source": "/", "destination": "/v34.html", "permanent": false}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Cache-Control", "value": "no-store, max-age=0"}
      ]
    }
  ]
}
